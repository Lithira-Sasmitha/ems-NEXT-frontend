# ============================================================
# Next.js (TypeScript) - Optimized .gitignore
# ============================================================

# Node dependencies
node_modules/
.pnpm
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next/
out/
build/

# Yarn 2+ (Berry)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment files
.env
.env*.local

# TypeScript build files
*.tsbuildinfo
next-env.d.ts

# Logs
logs
*.log
*.log.*
debug.log

# OS / Editor Files
.DS_Store
Thumbs.db

# Vercel deployment
.vercel/

# Coverage reports
coverage/

# Misc cert files
*.pem
